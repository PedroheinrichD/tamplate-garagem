# Copie para .env e preencha com os valores reais.
# Nunca commitar .env de verdade - ele já está no .gitignore.

# MySQL hospedado na Aiven. Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Usada tanto em runtime (src/lib/db.ts, via @prisma/adapter-mariadb) quanto
# pela CLI/migrations (prisma.config.ts). A Aiven exige TLS: baixe o "CA
# certificate" no painel do serviço e salve em certs/ca.pem (a raiz do
# projeto já ignora *.pem no .gitignore).
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# Usados só pelo script local `npm run admin:create` (não é lido em runtime).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha"

# Better Auth (login único do /admin, sem autorregistro - ver src/lib/better-auth.ts).
# SECRET: 32+ chars de alta entropia. Gerar com `openssl rand -base64 32` ou
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Trocar o secret invalida todas as sessões ativas.
BETTER_AUTH_SECRET="troque-por-um-valor-aleatorio-de-32-chars-ou-mais"
# URL pública onde a app roda (usada pra montar callbacks/origin checks).
BETTER_AUTH_URL="http://localhost:3000"

# Cloudinary (Dashboard -> Settings -> API Keys). Storage das fotos de
# veículo - só server-side (src/lib/cloudinary.ts), nunca NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME="seu-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="segredo-da-api"
