# Copie para .env e preencha com os valores reais (Supabase Dashboard -> Project Settings).
# Nunca commitar .env de verdade - ele já está no .gitignore.

# Runtime da app: pooler TRANSACTION (6543) + pgbouncer. Bom para serverless (Vercel).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations / Prisma CLI: pooler SESSION (5432), suporta DDL. Não é lido em runtime na Vercel,
# só localmente por `prisma migrate dev`. Pode deixar em branco na Vercel se não rodar migrations por lá.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres"

# Usados só pelo script local `npm run admin:create` (não é lido em runtime).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha"

# Supabase (Dashboard -> Project Settings -> API keys). Formato novo sb_...
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# publishable = substitui a antiga anon key; pública por design, vai para o browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# secret = substitui a antiga service_role. SEGREDO. Só server-side. Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
