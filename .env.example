# Copie para .env e preencha com os valores reais.
# Nunca commitar .env de verdade - ele já está no .gitignore.

# MySQL hospedado na Aiven. Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Usada tanto em runtime (src/lib/db.ts, via @prisma/adapter-mariadb) quanto
# pela CLI/migrations (prisma.config.ts). A Aiven exige TLS: baixe o "CA
# certificate" no painel do serviço e salve em certs/ca.pem (a raiz do
# projeto já ignora *.pem no .gitignore).
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# Usados só pelo script local `npm run admin:create` (não é lido em runtime).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha"

# Supabase (Dashboard -> Project Settings -> API keys). Formato novo sb_...
# Usado só para Auth (/admin) e Storage (fotos de veículo) - o banco de dados
# do Supabase não é mais usado.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# publishable = substitui a antiga anon key; pública por design, vai para o browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# secret = substitui a antiga service_role. SEGREDO. Só server-side. Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
