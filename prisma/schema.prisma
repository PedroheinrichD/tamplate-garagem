// Benevento's Veículos - schema do banco (PostgreSQL / Supabase)
// A camada de acesso continua sendo src/lib/vehicles.ts; este schema descreve
// o que o banco guarda. Nomes de tabela em pt-BR via @@map; modelos e campos
// em inglês para casar com src/types/vehicle.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: a URL de conexão fica em prisma.config.ts (CLI/migrations) e no
  // adapter passado ao PrismaClient em runtime (src/lib/db.ts). Nunca no schema.
}

// ---------------------------------------------------------------------------
// Veículos
// ---------------------------------------------------------------------------

enum FuelType {
  FLEX     @map("Flex")
  GASOLINA @map("Gasolina")
  DIESEL   @map("Diesel")
  HIBRIDO  @map("Híbrido")
  ELETRICO @map("Elétrico")
}

enum Transmission {
  MANUAL       @map("Manual")
  AUTOMATICO   @map("Automático")
  AUTOMATIZADO @map("Automatizado")
  CVT          @map("CVT")
}

enum BodyType {
  HATCH   @map("Hatch")
  SEDA    @map("Sedã")
  SUV     @map("SUV")
  PICAPE  @map("Picape")
  MINIVAN @map("Minivan")
}

enum VehicleStatus {
  AVAILABLE @map("disponivel")
  RESERVED  @map("reservado")
  SOLD      @map("vendido")
}

model Vehicle {
  id               String        @id @default(cuid())
  slug             String        @unique // rota /estoque/[slug]
  brand            String
  model            String
  version          String
  year             Int // ano modelo
  manufactureYear  Int           @map("manufacture_year") // ano de fabricação
  price            Int // R$ inteiros (à vista), igual ao mock
  mileage          Int // km
  fuel             FuelType
  transmission     Transmission
  body             BodyType
  color            String
  doors            Int
  plateEnd         Int           @map("plate_end") // final da placa (rodízio)
  featuredPosition Int?          @unique @map("featured_position") // 1, 2 ou 3; null = não é destaque
  status           VehicleStatus @default(AVAILABLE)
  highlights       String[] // 2-3 frases curtas de venda
  features         String[] // itens de série e opcionais
  description      String

  photos    VehiclePhoto[]
  leads     Lead[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // ADMINISTRATIVO. Nunca exposto em consulta pública nem enviado ao client.
  // Enforcement: `omit` global no PrismaClient (src/lib/db.ts, VEHICLE_ADMIN_FIELDS).
  // Só uma query de contexto admin, com `omit: { <campo>: false }` explícito, lê estes.
  licensePlate  String? @map("license_plate")
  renavam       String?
  chassis       String?
  fipeCode      String? @map("fipe_code")
  purchaseCost  Int?    @map("purchase_cost")
  internalNotes String? @map("internal_notes")

  @@index([status])
  @@index([brand])
  @@index([body])
  @@index([price])
  @@index([year])
  @@map("veiculos")
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String   @map("vehicle_id")
  url       String
  alt       String?
  position  Int      @default(0) // ordem na galeria; a menor é a capa
  createdAt DateTime @default(now()) @map("created_at")

  @@index([vehicleId, position])
  @@map("veiculo_fotos")
}

// ---------------------------------------------------------------------------
// Leads (formulários - hoje só abrem o WhatsApp, não persistem)
// ---------------------------------------------------------------------------

enum LeadKind {
  CONTATO
  TROCA
  INTERESSE
  FINANCIAMENTO
}

enum LeadStatus {
  NEW     @map("novo")
  WORKING @map("em_atendimento")
  WON     @map("fechado")
  LOST    @map("perdido")
}

model Lead {
  id        String     @id @default(cuid())
  kind      LeadKind
  name      String
  phone     String // WhatsApp com DDD
  subject   String? // form de contato ("Quero comprar", ...)
  message   String? // form de contato
  tradeCar  String?    @map("trade_car") // form de troca: "Onix 1.0 2019, 60 mil km"
  tradeKm   Int?       @map("trade_km") // form de troca (opcional)
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId String?    @map("vehicle_id") // "Tenho interesse" / "Simular financiamento"
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([kind])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Depoimentos (hoje hardcoded em components/home/Testimonials.tsx)
// ---------------------------------------------------------------------------

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  context   String // "levou um Corolla XEi"
  published Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("depoimentos")
}

// ---------------------------------------------------------------------------
// Configuração institucional (hoje em src/lib/site.ts)
// Linha única; id fixo "default".
// ---------------------------------------------------------------------------

model SiteConfig {
  id              String   @id @default("default")
  name            String
  shortName       String   @map("short_name")
  tagline         String
  soldCount       Int      @map("sold_count")
  yearsActive     Int      @map("years_active")
  instagramHandle String   @map("instagram_handle")
  instagramUrl    String   @map("instagram_url")
  whatsappNumber  String   @map("whatsapp_number") // só dígitos, 55 + DDD
  whatsappMessage String   @map("whatsapp_message")
  email           String
  addressStreet   String   @map("address_street")
  addressDistrict String   @map("address_district")
  addressCity     String   @map("address_city")
  addressState    String   @map("address_state")
  addressZip      String   @map("address_zip")
  mapsUrl         String   @map("maps_url")
  hours           Json // [{ days: string, time: string }]
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("configuracoes")
}
